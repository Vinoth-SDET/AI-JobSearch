# Copy to .env for local development. Never commit your real Apify token.
APIFY_TOKEN=

# Live Actor runs are disabled until explicitly enabled.
JOB_DISCOVERY_ENABLED=false

# Hard maximum spend allowed per discovery request. The caller must also
# provide a request budget no greater than this cap.
JOB_DISCOVERY_MAX_BUDGET_USD=1.00

# Store IDs checked against public metadata; recheck schemas and terms before live use.
APIFY_LINKEDIN_ACTOR_ID=bebity/linkedin-jobs-scraper
APIFY_INDEED_ACTOR_ID=borderline/indeed-scraper
APIFY_GOOGLE_ACTOR_ID=apify/google-search-scraper
